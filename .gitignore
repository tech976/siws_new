# deps
node_modules
.pnp
.pnp.js

# next
.next/
out/
build/
next-env.d.ts

# payload — uploads.
#
# /media IS committed. It holds the web-sized derivatives the site renders:
# ~2,000 files, 264 MB, none larger than 1.1 MB. Committing them means a fresh
# clone shows every photograph without needing the camera originals or a
# re-import, which is what makes the repository shareable.
#
# The camera originals stay out (see /SIWS Content below) — they run to 1.1 GB
# and include a 216 MB video, past GitHub's 100 MB per-file limit.
#
# /protected-media stays out: it is where consent-restricted files live.
/protected-media

# env — never commit secrets or the DB URI
.env
.env*.local
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# photo drop folder — originals never enter version control
/photos-inbox

# Source material from SIWS — 1.1 GB of camera originals, Word documents and
# video. The photographs enter the site through `photos:import`, which writes
# web-sized derivatives into /media; the originals stay on the machine that
# received them. Committing them would put a gigabyte of binaries into every
# clone for no benefit.
/SIWS Content

# A personal copy of the SRS. The current spec is committed; this is not.
SIWS_School_Website_SRS_v2_ORIGINAL_backup.pdf

# Editing masters — the multi-gigabyte exports a video comes out of. These
# never belong in git: they stay in history forever once added, and nobody
# cloning the site needs the source of a film they can already play.
Sequence*.mp4

# THE DEPLOYED FILMS ARE COMMITTED, and were not until 2026-09-02.
#
# `public/hero/*.mp4` and `public/reels/*.mp4` were ignored alongside the
# masters, which meant a clone had every page of the site and none of its
# video: the banner fell back to a still and both reel sections rendered
# nothing. A deployment built from this repository was not the site.
#
# They are 44 MB in total, compressed for the web — the hero film at 13 MB and
# seven reels between 1.8 and 10 MB. That is a real cost to a clone, paid once,
# against a production site that is missing its opening film.

# Records which commit this machine last built its database from, written by
# `seed:refresh` and read by `seed:verify`. Local state — it describes THIS
# database, not the project.
.seed-state.json

# The working folders SIWS sends photographs in. The pictures themselves are
# committed under assets/images once they have a name, a section and alt text;
# the folders are a delivery, not a source.
/Jr Clg Images *
/siws primary images
/siws kindergarten
/Reel Showcase
