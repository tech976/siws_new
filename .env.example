# =============================================================================
# SIWS platform — environment
#
# Copy to `.env` on the server and fill in. Never commit the filled file:
# `.env` is in .gitignore and must stay there.
# =============================================================================

# PostgreSQL. On the VPS this is a local socket/port, so no SSL parameters.
# Create the role and database first — see docs/DEPLOYMENT.md.
DATABASE_URI=postgres://siws:CHANGE_ME@localhost:5432/siws

# Signs Payload's session cookies and preview tokens.
# Generate a fresh one per environment:  openssl rand -base64 48
# Changing it logs every admin user out.
PAYLOAD_SECRET=CHANGE_ME

# The public origin, with protocol and no trailing slash. Used for canonical
# URLs, Open Graph tags and the media URLs Payload writes into the database.
# Get this right before the first content save — a wrong value ends up baked
# into stored URLs.
NEXT_PUBLIC_SERVER_URL=https://siwsschool.edu.in

# BR-SEO-08 — search-engine indexing is OPT-IN, so staging can never leak into
# search results by accident. Anything other than the exact string `true` keeps
# the site out of the index. Set to `true` ONLY on production, at go-live.
NEXT_PUBLIC_ENABLE_INDEXING=false

# Guards the draft-preview route. Generate like PAYLOAD_SECRET.
PREVIEW_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Instagram feed (optional)
#
# The front-page Instagram grid shows live posts when this is set, and the
# posts curated in the CMS when it is not — so leaving it blank is a supported
# state, not a broken one.
#
# There is no public feed to read: Meta shut the Basic Display API down on
# 4 December 2024, so a token is the only supported way in.
#
# THERE ARE TWO ROUTES. See docs/INSTAGRAM.md.
#
#   A. Business Discovery — no access to @siws_wadala needed.
#      Reads its public posts using YOUR OWN Meta credentials. Set all three
#      variables below. Use this when nobody to hand can sign in to the school
#      account.
#
#   B. Own account — set INSTAGRAM_ACCESS_TOKEN only, and leave the other two
#      blank. Requires signing in as @siws_wadala.
#
# Tokens are long-lived (60 days) and must be refreshed — docs/INSTAGRAM.md has
# the command and the reminder to set.
INSTAGRAM_ACCESS_TOKEN=

# Route A only. The Instagram user id of YOUR OWN professional account (the one
# the token belongs to) — not the school's.
INSTAGRAM_USER_ID=

# Route A only. The public professional account to read, without the @.
# Leave blank to use route B.
INSTAGRAM_TARGET_USERNAME=

# ---------------------------------------------------------------------------
# Outgoing mail (required for any form to reach anybody)
#
# Every public form — the admission enquiry, the campus tour request and the
# feedback box — is stored in the admin panel AND emailed to the address set on
# the school's Unit record under "Where messages go".
#
# WITHOUT THESE, NO MAIL IS SENT. Payload falls back to writing the message to
# the server console: the form still reports success to the parent and the
# record still appears in the panel, so the only sign that nothing arrived is
# one line at boot reading "No email adapter provided". Set these before
# go-live, and send yourself a test enquiry to prove it.
#
# All three of HOST, USER and PASSWORD are needed together — a half-filled set
# is ignored rather than half-used, so a missing password cannot turn into mail
# that silently bounces.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# What school staff see in the "From" line. Defaults to SMTP_USER.
# Many providers refuse to send as an address the account does not own, so keep
# this the same mailbox unless SIWS's provider says otherwise.
SMTP_FROM=
SMTP_FROM_NAME=SIWS website
